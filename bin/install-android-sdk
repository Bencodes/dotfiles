#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo 'Usage: install-android-sdk [SDK package ...]'
  echo 'Default: platform-tools platforms;android-36 build-tools;36.0.0 sources;android-36'
  echo 'Example: install-android-sdk "platforms;android-35" "build-tools;35.0.0" "ndk;27.2.12479018"'
  echo 'Uses ANDROID_HOME (or ANDROID_SDK_ROOT), otherwise the Android Studio default.'
  echo 'License acceptance is interactive. Re-running installs only missing packages.'
  exit 0
fi

# Resolve the repository even when invoked through ~/.bin.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=config/android/env.sh
source "$script_dir/../config/android/env.sh"

if ! command -v brew >/dev/null; then
  for prefix in /home/linuxbrew/.linuxbrew /opt/homebrew /usr/local; do
    if [[ -x "$prefix/bin/brew" ]]; then
      eval "$("$prefix/bin/brew" shellenv)"
      break
    fi
  done
fi

if [[ -x "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" ]]; then
  sdkmanager="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
elif command -v sdkmanager >/dev/null; then
  sdkmanager="$(command -v sdkmanager)"
else
  if ! command -v brew >/dev/null; then
    echo 'Install Homebrew (https://brew.sh) or provide sdkmanager on PATH.' >&2
    exit 1
  fi
  brew install --cask android-commandlinetools
  sdkmanager="$(brew --prefix)/bin/sdkmanager"
fi

# Fresh login shells may not have loaded the interactive Java configuration.
if [[ -z ${JAVA_HOME:-} ]] && command -v brew >/dev/null; then
  java_prefix="$(brew --prefix)/opt/openjdk@21"
  if [[ -d "$java_prefix" ]]; then
    if [[ $OSTYPE == darwin* ]]; then
      export JAVA_HOME="$java_prefix/libexec/openjdk.jdk/Contents/Home"
    else
      export JAVA_HOME="$java_prefix/libexec"
    fi
  fi
fi

if [[ $# -eq 0 ]]; then
  set -- platform-tools 'platforms;android-36' 'build-tools;36.0.0' 'sources;android-36'
fi

mkdir -p "$ANDROID_HOME"
"$sdkmanager" "--sdk_root=$ANDROID_HOME" --install "$@"

# sdkmanager may exit successfully after a license was declined.
for package in "$@"; do
  if [[ ! -f "$ANDROID_HOME/${package//;/\/}/package.xml" ]]; then
    echo "Package was not installed: $package. Re-run and accept its license." >&2
    exit 1
  fi
done
printf 'Android SDK ready at %s\n' "$ANDROID_HOME"
