#!/usr/bin/env bash

# Rust
export CARGO_HOME="$HOME/.cargo"

# Java
if [[ $OSTYPE == darwin* ]]; then
  JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
else
  JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@25/libexec"
fi
export JAVA_HOME

# Kotlin
export KOTLIN_HOME="$HOMEBREW_PREFIX/opt/kotlin/"

# Configure the paths
paths=(
  "$HOME/.bin"                    # User
  "$HOME/.local/bin"              # User-installed CLI tools
  "$HOMEBREW_PREFIX/bin"          # Homebrew
  /usr/local/bin
  "$CARGO_HOME/bin"               # Rust
  "$JAVA_HOME/bin"                # Java
  "$HOMEBREW_PREFIX/sbin"         # Homebrew sbin
  /usr/local/sbin
  /usr/bin                        # System
  /bin
  /usr/sbin
  /sbin
  "$HOME/.lmstudio/bin"           # LM Studio
  "$HOME/.rd/bin"							    # Rancher
)

new_path=""
for search_path in "${paths[@]}"; do
  [[ -d $search_path ]] \
  && [[ ":$new_path:" != *":$search_path:"* ]] \
  && new_path="${new_path:+$new_path:}$search_path"
done

export PATH="$new_path"

# shellcheck source=config/android/env.sh
source "$HOME/.config/android/env.sh"
