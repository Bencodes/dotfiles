#!/usr/bin/env bash

# Editing
readonly editor=nvim
export EDITOR=$editor
export VISUAL=$editor

# Use the new Docker compose bake feature by default
export COMPOSE_BAKE=true

# Go
export GOPATH=$HOME/Workspace
export GOROOT="$HOMEBREW_PREFIX/opt/go/libexec"

# Neovim
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# RipGrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/rgrc.conf"

# Homebrew Token
export HOMEBREW_GITHUB_API_TOKEN="${HOMEBREW_GITHUB_API_TOKEN:-TOKEN_GOES_HERE}"

# Homebrew Cask Install Directory
export HOMEBREW_CASK_OPTS="--appdir=~/Applications"

# No homebrew analytics
export HOMEBREW_NO_ANALYTICS=1

# Skip auto formatting
export SKIP_FORMATTING=true

# Android paths are initialized by ~/.paths, before interactive shell setup.

# Skim https://github.com/lotabout/skim
export SKIM_DEFAULT_COMMAND="fd"

# GPG Agent
if [[ -t 0 ]] && command -v gpgconf >/dev/null; then
    GPG_TTY="$(tty)"
    export GPG_TTY
    if [[ -z ${SSH_AUTH_SOCK:-} ]]; then
        SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
        export SSH_AUTH_SOCK
        gpgconf --launch gpg-agent
    fi
fi
